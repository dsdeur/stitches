{
  "$schema": "./.vscode/package.schema.json",
  "name": "stitches",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "contributors": [
    "Pedro Duarte",
    "Abdulhadi Alhallak <abdul@workos.com>",
    "Jonathan Neal"
  ],
  "scripts": {
    "build:test:types": "yarn workspace @stitches/test build",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "lint": "oxlint && yarn lint:pkg",
    "lint:pkg": "publint --pack npm packages/core && publint --pack npm packages/react && publint --pack npm packages/stringify",
    "release": "node .task/release.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "test:declared": "node .task/test-declared.js",
    "test:browser": "tsx docs/bench/browser-check.mts"
  },
  "workspaces": [
    "packages/core",
    "packages/react",
    "packages/test",
    "packages/stringify"
  ],
  "dependencies": {
    "@types/node": "16.9.6",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/react-test-renderer": "19",
    "csstype": "3.0.9",
    "react": "19",
    "react-test-renderer": "19",
    "typescript": "6.0.2"
  },
  "browserslist": [
    "last 1 chrome versions",
    "last 1 firefox versions",
    "last 1 safari versions",
    "maintained node versions"
  ],
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": true,
    "printWidth": 240,
    "quoteProps": "consistent",
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "useTabs": true,
    "overrides": [
      {
        "files": [
          "*.json",
          "*.md",
          ".prettierrc",
          "*.yml"
        ],
        "options": {
          "useTabs": false
        }
      }
    ]
  },
  "private": true,
  "devDependencies": {
    "oxlint": "1.81.0",
    "playwright": "1.63.0",
    "prettier": "3.8.2",
    "publint": "0.3.24",
    "react-dom": "19",
    "tsdown": "0.23.0",
    "tsx": "4.21.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
