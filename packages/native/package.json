{
  "name": "@stitches/native",
  "version": "1.3.1-1",
  "description": "Share a stitches theme with React Native and anything else that is not CSS",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/*.cjs",
    "dist/*.mjs",
    "dist/*.map",
    "dist/*.d.mts",
    "dist/*.d.cts"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": "dsdeur/stitches",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "design tokens",
    "react native",
    "stitches",
    "theme",
    "tokens"
  ]
}
