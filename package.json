{
  "$schema": "./.vscode/package.schema.json",
  "name": "stitches",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "contributors": [
    "Pedro Duarte",
    "Abdulhadi Alhallak <abdul@workos.com>",
    "Jonathan Neal"
  ],
  "scripts": {
    "build:test:types": "yarn workspace @stitches/test build",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "lint": "node .task/lint.js",
    "lint:esm": "node .task/lint-esm.js",
    "lint:pkg": "node .task/lint-pkg.js",
    "release": "node .task/release.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "workspaces": [
    "packages/core",
    "packages/react",
    "packages/test",
    "packages/stringify"
  ],
  "dependencies": {
    "@skypack/package-check": "0.2.2",
    "@types/node": "16.9.6",
    "@types/react": "17.0.83",
    "@types/react-dom": "17.0.26",
    "@types/react-test-renderer": "17.0.9",
    "@typescript-eslint/eslint-plugin": "5.36.2",
    "@typescript-eslint/parser": "5.36.2",
    "csstype": "3.0.9",
    "eslint": "7.32.0",
    "react": "17.0.2",
    "react-test-renderer": "17.0.2",
    "typescript": "6.0.2"
  },
  "browserslist": [
    "last 1 chrome versions",
    "last 1 firefox versions",
    "last 1 safari versions",
    "maintained node versions"
  ],
  "eslintConfig": {
    "env": {
      "browser": true,
      "es6": true,
      "node": true
    },
    "extends": "eslint:recommended",
    "globals": {
      "describe": false,
      "expect": false,
      "test": false
    },
    "parserOptions": {
      "ecmaVersion": 12,
      "sourceType": "module",
      "ecmaFeatures": {
        "modules": true
      }
    },
    "rules": {
      "semi": [
        "error",
        "never"
      ]
    },
    "overrides": [
      {
        "files": ["*.ts", "*.tsx"],
        "env": {
          "browser": true,
          "es6": true,
          "node": true
        },
        "extends": [
          "plugin:@typescript-eslint/recommended"
        ],
        "parser": "@typescript-eslint/parser",
        "parserOptions": {
          "ecmaVersion": 2020,
          "sourceType": "module",
          "ecmaFeatures": {
            "jsx": true
          }
        },
        "settings": {
          "react": {
            "version": "detect"
          }
        },
        "rules": {
          "@typescript-eslint/ban-types": [
            "error",
            {
              "extendDefaults": true,
              "types": {
                "{}": false
              }
            }
          ],
          "@typescript-eslint/no-explicit-any": "off",
          "@typescript-eslint/no-for-in-array": "off",
          "@typescript-eslint/no-unnecessary-qualifier": "off",
          "@typescript-eslint/no-unnecessary-type-assertion": "off",
          "@typescript-eslint/promise-function-async": "off",
          "@typescript-eslint/restrict-plus-operands": "off"
        }
      }
    ]
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": true,
    "printWidth": 240,
    "quoteProps": "consistent",
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "useTabs": true,
    "overrides": [
      {
        "files": [
          "*.json",
          "*.md",
          ".prettierrc",
          "*.yml"
        ],
        "options": {
          "useTabs": false
        }
      }
    ]
  },
  "private": true,
  "devDependencies": {
    "prettier": "3.8.2",
    "tsdown": "0.23.0",
    "tsx": "4.21.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
