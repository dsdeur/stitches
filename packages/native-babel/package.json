{
  "name": "@stitches/native-babel",
  "version": "1.3.1-1",
  "description": "Opt-in Babel plugin for @stitches/native: styled components without a component of their own",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/*.cjs",
    "dist/*.mjs",
    "dist/*.map",
    "types/*.d.ts"
  ],
  "peerDependencies": {
    "@babel/core": "^7.0.0"
  },
  "sideEffects": false,
  "license": "MIT",
  "repository": "dsdeur/stitches",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "babel-plugin",
    "react native",
    "stitches",
    "styled"
  ]
}
