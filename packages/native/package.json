{
  "name": "@stitches/native",
  "version": "1.3.1-1",
  "description": "Stitches for React Native: the same config, resolved to plain values",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "files": [
    "dist/*.cjs",
    "dist/*.mjs",
    "dist/*.map",
    "dist/*.d.mts",
    "dist/*.d.cts"
  ],
  "peerDependencies": {
    "react": ">=16.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "repository": "dsdeur/stitches",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "css-in-js",
    "design tokens",
    "react native",
    "responsive",
    "stitches",
    "styled",
    "theme",
    "tokens",
    "variants"
  ]
}
